server {
    listen 8080;

    # имя сервиса резолвится через dns докера при каждом запросе
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $audit_upstream http://audit-svc:8080;

    # /reload снаружи закрыт, сюда попадают и //reload и %72eload
    location ^~ /reload {
        return 404;
    }

    location / {
        proxy_pass $audit_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# stub_status только для exporter, этот порт наружу не публикуется
server {
    listen 8081;
    location = /stub_status {
        stub_status;
    }
}
